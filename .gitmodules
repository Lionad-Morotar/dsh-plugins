[submodule "refs/deepseek-harness-for-vs-code"]
	path = refs/deepseek-harness-for-vs-code
	url = git@github.com:Lionad-Morotar/Deepseek-Harness-for-VS-Code.git
	ignore = all
[submodule "packages/dsh-jump"]
	path = packages/dsh-jump
	url = git@github.com:Lionad-Morotar/dsh-jump.git
	ignore = all
[submodule "packages/dsh-notify-me"]
	path = packages/dsh-notify-me
	url = git@github.com:Lionad-Morotar/dsh-notify-me.git
	ignore = all
[submodule "refs/vscode-wakatime"]
	path = refs/vscode-wakatime
	url = https://github.com/wakatime/vscode-wakatime
	ignore = all
[submodule "forks/dsh-wakatime-plugin"]
	ignore = all
	path = forks/dsh-wakatime-plugin
	url = https://github.com/Lionad-Morotar/dsh-wakatime-plugin

/* DSH 插件集 — LikeC4 架构模型。事实源：.planning/codebase/ARCHITECTURE.md 等；本文件随其同步维护 */
specification {
  element actor { notation "人员"; style { shape person } }
  element system { notation "软件系统" }
  element container { notation "容器" }
  element component { notation "组件"; style { shape component } }
  element database { notation "存储"; style { shape storage } }
  element dataSource { notation "上游内容源"; style { shape storage } }

  deploymentNode environment { notation "环境"; style { color gray } }
  deploymentNode host { notation "宿主机" }
  deploymentNode runtime { notation "运行时" }
}

model {
  actor user "Lionad" {
    description "DSH 用户兼本仓库维护者"
  }

  system dshPlugins "DSH 插件集" {
    description "Lionad 的 DeepSeek Harness 插件 monorepo：五包四形态，共用 Loader row 发行模型"

    container skin "@lionad/dsh-client-ui-skin-ascii-rest" {
      description "DSH 客户端 UI 皮肤：把 ascii.rest 场景渲染为工作区背景，随亮暗主题换配色"
      technology "TypeScript + esbuild，lib/ 提交入库"

      component entry "client/entry" {
        description "客户端半边入口，boot(require) 安装模块加载器"
      }
      component loader "client/loader" {
        description "装载器桥：承接宿主工厂 require，模块作用域外传递"
      }
      component contract "client/dsh" {
        description "宿主契约：手写 DSH/Cordis 结构化类型，零 SDK 依赖"
      }
      component app "client/app" {
        description "皮肤行为汇点：body 属性、token 层、挂画、完整 teardown"
      }
      component surface "client/surface" {
        description "背景画布：fixed 层 z-index -1，换主题重挂载而非原地改色"
      }
      component mountRenderer "mount" {
        description "vendored 渲染器：ascii.rest canvas mount，摘掉 pre 路径"
      }
      component tokens "client/tokens" {
        description "主题 token：只动表面 token + 品牌强调色"
      }
      component scenes "client/scenes" {
        description "场景加载：salt-flat 内联兜底，其余 require.async 按需取分块"
      }
      component store "client/store" {
        description "设置存储：localStorage 文档 + 订阅，值真实变化才通知"
      }
      component settingsPage "client/page" {
        description "React 设置页：联络表 + 实时画布预览"
      }
      component gui "client/gui" {
        description "lil-gui 调参面板，独立分块 client.gui.js"
      }
    }

    container scenesLib "ascii-rest-scenes" {
      description "纯逻辑层：场景目录、cover 取景、调色板、设置归一化，零 DOM"
      technology "TypeScript，barrel 导出源码"

      component catalog "catalog" {
        description "34 个场景 meta：构建期生成、加载时一次校验缓存"
      }
      component cover "cover" {
        description "contain/cover 拟合、九宫格 anchor、zoom"
      }
      component palette "palette" {
        description "纸色翻转（paperify）、HSL/Hex 数学、对比度"
      }
      component options "options" {
        description "设置归一化：默认值 + 不受信输入清洗，返回 null/默认值不抛异常"
      }
    }

    container jump "dsh-jump" {
      description "web profile 的键盘跳跃导航：Cmd+H 点击 / Cmd+U 聚焦，视口内候选分派单键或两键 label"
      technology "TypeScript + esbuild，纯 client 半边，运行期零三方依赖"

      component hostStub "src/index" {
        description "宿主半边空 apply：Loader 双侧按包名挂载，main 必须可解析"
      }
      component jumpEntry "client/entry" {
        description "客户端工厂：返回 {name, inject, apply}，配置只从 apply 第二参读"
      }
      component jumpApp "client/app" {
        description "跳跃接线：捕获阶段 keydown、浮层驱动、命中执行 click/focus、对称 teardown"
      }
      component jumpConfig "client/config" {
        description "默认值：九键首页行、Cmd+H/Cmd+U、候选选择器"
      }
      component hints "client/hints" {
        description "视口快照：可见性裁剪、祖先去重、整轮等长 label 分派，纯函数"
      }
      component keys "client/keys" {
        description "三态状态机：idle/click/focus，前缀累积与死路清空，无 DOM"
      }
      component overlay "client/overlay" {
        description "label 浮层：单容器 fixed 全屏、pointer-events:none、按前缀亮暗"
      }
    }

    container slashCommands "dsh-slash-commands" {
      description "三端 slash 命令：tui 的 /copy 把最近 n 轮回复并发写进三条剪贴板路径；web 与 desktop 的 /rename 改会话标题、/resume 切到另一条会话，另给页面的剪贴板写入加上限"
      technology "TypeScript + esbuild，host 半边 lib/index.js（ESM）+ client 半边 lib/client.js（ModuleLoader 工厂）"

      component tuiEntry "src/index" {
        description "宿主 apply 本体：inject commands 与 sessionTitle、按终端能力分派哪条命令注册、/copy 注册延后一宏任务、helper 统一 2 秒上限"
      }
      component clientEntry "client/entry" {
        description "客户端 apply 本体：inject commandUi/sessions/workspaces/uiWorkspace，用 effect 注册有界剪贴板与 /resume 两件事"
      }
      component resume "client/resume" {
        description "/resume 的全部纯判定：会话行集投影、范围档（project/all）、切换派发，DOM-free"
      }
      component resumeCommand "client/resume-command" {
        description "/resume 接线：打开时读会话与归档快照，范围行经 popupFor 重开弹层并把搜索词带过去，会话行调 uiWorkspace.openSession"
      }
      component clipboardShim "client/clipboard-shim" {
        description "有界剪贴板写入：包装页面 navigator.clipboard.writeText，120 ms 预算 + execCommand 兜底，必然结算；兜底夺走的焦点归还给原持有元素"
      }
      component rename "rename" {
        description "参数文法 /rename <title>：只去首尾空白，空标题按用法错误拒绝"
      }
      component renameCommand "rename-command" {
        description "改名命令组装：标题交给 sessionTitle 归一化，失败按输入非法/会话不在活动态/服务停用分三类"
      }
      component command "command" {
        description "命令组装与注册：宿主中介优先，未准入回落 commands.register"
      }
      component args "arguments" {
        description "参数文法 /copy [n] [--all]：正整数、超过 50 夹取，非法输入直接拒绝"
      }
      component history "history" {
        description "从会话事件流选轮次：每轮最后一条非空正文，--all 只带真人发言"
      }
      component clipboard "clipboard" {
        description "剪贴板三路并发：native / tmux-buffer / OSC 52，如实报 attempted/landed/degraded"
      }
      component manifest "dsh-plugin.json" {
        description "准入清单（Community Draft 0.15）：只声明宿主侧的 /copy 与 /rename 及各自的 commands.invoke 权限；/resume 是纯客户端贡献，不在此清单"
      }
    }

    container keybindings "dsh-better-keybindings" {
      description "web 与 desktop 共用的键盘修正：Home/End 移动光标而非滚动聊天区，PageUp/PageDown 改为半屏翻页"
      technology "TypeScript + esbuild，纯 client 半边，运行期零三方依赖"

      component kbEntry "client/entry" {
        description "客户端工厂：返回 {name, inject, apply}，apply 只挂一个捕获阶段 keydown"
      }
      component kbApp "client/app" {
        description "接线与全部 DOM 副作用：判目标、preventDefault、移动光标、补齐光标可见性、对称 teardown"
      }
      component kbKeys "client/keys" {
        description "事件到动作的纯映射：光标（行/文档粒度、是否扩选）与半屏翻页各一个入口，含目标分类与转录区命中判定"
      }
      component kbCaret "client/caret" {
        description "两套光标原语：文本框走字符串算术，富文本走 Selection.modify(lineboundary)"
      }
      component kbReveal "client/reveal" {
        description "两套滚动算术：光标补齐（最小增量，聊天滚动容器显式排除）与翻页落点（半屏、两端钳制、无位移不写）"
      }
    }
  }

  system dshHost "DSH 宿主" {
    description "外部宿主：Cordis 上下文 + 模块加载器；web 面 slots/theme/locale 与 commandUi/sessions/workspaces/uiWorkspace，tui 面 commands/tuiPluginHost/tuiToast"
    technology "Cordis 4 + DSH 0.2 rc"
  }

  system localStorage "浏览器 localStorage" {
    description "用户设置持久化，键 dsh-skin:ascii-rest:settings，皮肤独占读写"
    style { shape storage }
  }

  dataSource asciiRest "ascii.rest 上游" {
    description "场景代码与 meta 唯一来源（github:bas3line/ascii#c556be4，MIT）；构建期消费，运行期零网络"
    technology "git 依赖，commit 钉死"
  }

  system systemClipboard "系统剪贴板" {
    description "本机剪贴板：native 工具写入（pbcopy / clip / wl-copy / xclip / xsel）；SSH 下跳过，避免写远端"
    technology "子进程 stdin，退出码判定"
  }

  system terminalHost "终端与 tmux" {
    description "终端侧剪贴板通道：tmux buffer 与 OSC 52 转义；能否落地取决于终端设置"
    technology "tmux load-buffer + ESC ] 52 ; c ; base64 BEL（tmux 内包 DCS 透传）"
  }

  system browserClipboard "浏览器剪贴板" {
    description "页面侧剪贴板写入：navigator.clipboard.writeText 与 execCommand('copy') 兜底；文档失焦或无用户激活时平台调用可能永不结算"
    technology "Clipboard API + 临时选区复制"
  }

  user -> dshPlugins "使用与维护"

  dshHost -> skin "Loader row 注入，require/require.async 加载 lib/ 分块"
  skin.entry -> dshHost "boot(require) 安装加载器"
  skin.app -> dshHost "apply(ctx)：slots/theme 服务，theme/change 事件"
  skin.app -> skin.surface "loadScene 后挂画"
  skin.surface -> skin.mountRenderer "复用 vendored 渲染器挂帧循环"
  skin.scenes -> skin.mountRenderer "场景 piece 交渲染器"
  skin.app -> skin.tokens "主题切换时 overrideTokens 打开表面 token"
  skin.settingsPage -> skin.store "store.update 写设置"
  skin.gui -> skin.store "调参写入"
  skin.store -> localStorage "读写设置文档"
  skin.store -> scenesLib.options "读出必经 normalizeSettings 清洗"
  skin.scenes -> scenesLib.catalog "按目录取场景 meta"
  skin.surface -> scenesLib.palette "按 scheme 生成主题调色板"
  skin.app -> scenesLib.cover "取景几何"
  scenesLib.catalog -> asciiRest "构建期遍历 dist/pieces 抽 meta（generate-catalog.mjs）"
  skin.mountRenderer -> asciiRest "构建期逐个打包 pieces 为 client.<id>.js 分块"
  skin.scenes -> asciiRest "salt-flat 静态内联兜底"

  dshHost -> jump "Loader row 注入（id: jump），加载 lib/client.js 工厂"
  jump.jumpEntry -> dshHost "window.__ModuleLoader__.load({id, factory})，id 必须等于包名"
  jump.jumpEntry -> jump.jumpApp "createApp({config}).apply()"
  jump.jumpApp -> jump.jumpConfig "读激活键与 candidateSelector"
  jump.jumpApp -> jump.keys "每次 keydown 进 matchKey"
  jump.jumpApp -> jump.hints "collectHints 快照视口候选并分派 label"
  jump.jumpApp -> jump.overlay "render(hints, pending) / destroy"
  jump.jumpApp -> dshHost "捕获阶段吞掉自己拥有的 keydown，不漏给宿主快捷键"

  dshHost -> slashCommands "Loader row 注入（id: dsh-slash-commands），按端加载半边"
  dshHost -> slashCommands.tuiEntry "三端加载宿主半边 lib/index.js"
  dshHost -> slashCommands.clientEntry "web 与 desktop 加载客户端半边 lib/client.js 工厂"
  slashCommands.clientEntry -> slashCommands.resumeCommand "apply 内用 effect 注册 /resume 贡献"
  slashCommands.clientEntry -> slashCommands.clipboardShim "apply 内用 effect 安装有界写入"
  slashCommands.resumeCommand -> slashCommands.resume "resumeRows 建行集、scopeRows 切档、switchTo 派发"
  slashCommands.resumeCommand -> dshHost "commandUi.popupFor(actx).open 重开弹层；uiWorkspace.openSession 切会话"
  slashCommands.clipboardShim -> browserClipboard "包装 writeText：120 ms 预算 + execCommand 兜底"
  slashCommands.tuiEntry -> slashCommands.command "延后一宏任务后调 registerCopyCommand"
  slashCommands.command -> slashCommands.args "parseCopyInput 解析文法"
  slashCommands.command -> slashCommands.history "collectTurns 选轮次，renderTurns 渲染"
  slashCommands.command -> slashCommands.clipboard "copyToClipboard 三路并发"
  slashCommands.command -> dshHost "优先 tuiPluginHost.registerCommand，未准入回落 commands.register；tuiToast 播报"
  slashCommands.history -> dshHost "读 invocation.agent.session 的事件流"
  dshHost -> slashCommands.manifest "admission-loader 读清单绑定插件身份，按 commands.invoke 管控（只覆盖宿主侧命令）"
  slashCommands.clipboard -> systemClipboard "native：pbcopy / clip / wl-copy / xclip / xsel"
  slashCommands.clipboard -> terminalHost "tmux load-buffer 与 OSC 52（tmux 内包 DCS 透传）"

  dshHost -> keybindings "Loader row 注入（id: better-keybindings），加载 lib/client.js 工厂"
  keybindings.kbEntry -> dshHost "window.__ModuleLoader__.load({id, factory})，id 必须等于包名"
  keybindings.kbEntry -> keybindings.kbApp "createApp().apply()"
  keybindings.kbApp -> keybindings.kbKeys "每次 keydown 先 classifyTarget 再 matchCaretKey"
  keybindings.kbApp -> keybindings.kbCaret "命中后 moveTextField / moveRichText"
  keybindings.kbApp -> keybindings.kbReveal "取消默认动作后自己把光标滚回可视区"
  keybindings.kbApp -> dshHost "捕获阶段拦下 Home/End：默认动作本会滚动 data-conversation-scroll"
}

deployment {
  environment install "安装态（profile）" {
    technology "DSH profile 依赖 + cordis.patch.yml Loader row，单实例"
    host machine "用户机器" {
      runtime dshRuntime "desktop profile：DSH 宿主进程" {
        instanceOf dshPlugins.skin
        instanceOf dshPlugins.keybindings
        instanceOf dshPlugins.slashCommands
      }
      runtime webRuntime "web profile：DSH 宿主进程" {
        instanceOf dshPlugins.jump
        instanceOf dshPlugins.keybindings
        instanceOf dshPlugins.slashCommands
      }
      runtime tuiRuntime "tui profile：DSH 宿主进程" {
        instanceOf dshPlugins.slashCommands
      }
      runtime clipboardHost "本机剪贴板工具与终端" {
        instanceOf systemClipboard
        instanceOf terminalHost
      }
      runtime browserRuntime "浏览器环境" {
        instanceOf dshPlugins.scenesLib
        instanceOf localStorage
      }
    }
  }
}

views {
  view index {
    title "系统全景：DSH 插件集"
    description "五包四形态：皮肤两包分层、jump 与 keybindings 纯 client、slash 命令 host 与 client 双半边；DSH 宿主 + 上游 ascii.rest + 两处剪贴板边界"
    include *
    autoLayout LeftRight
  }

  view skin of dshPlugins.skin {
    title "皮肤容器内部"
    include *
    include -> dshPlugins.skin
    autoLayout LeftRight
  }

  view scenesLib of dshPlugins.scenesLib {
    title "纯逻辑层内部"
    include *
    include -> dshPlugins.scenesLib
    autoLayout LeftRight
  }

  view jump of dshPlugins.jump {
    title "跳跃导航容器内部"
    description "纯 client 半边：入口 + 快照/状态机/浮层三段 + 仅保可解析的宿主空壳"
    include *
    include dshHost
    autoLayout LeftRight
  }

  view keybindings of dshPlugins.keybindings {
    title "键盘修正容器内部"
    description "纯 client 半边：一个捕获阶段 keydown + 映射/光标/可见性三段纯逻辑"
    include *
    include dshHost
    autoLayout LeftRight
  }

  view copy of dshPlugins.slashCommands {
    title "slash 命令容器内部"
    description "宿主半边：文法、轮次渲染、三路剪贴板与两条注册路径；客户端半边：/resume 的行集与切换、有界剪贴板包装"
    include *
    include dshHost, systemClipboard, terminalHost, browserClipboard
    autoLayout LeftRight
  }

  dynamic view renderFlow {
    title "主路径：渲染背景"
    dshHost -> dshPlugins.skin.entry "加载 lib/client.js 工厂"
    dshPlugins.skin.entry -> dshPlugins.skin.loader "boot(require) 安装 loader"
    dshHost -> dshPlugins.skin.app "调 apply(ctx)"
    dshPlugins.skin.app -> dshPlugins.skin.tokens "overrideTokens 打开表面 token"
    dshPlugins.skin.app -> dshPlugins.skin.scenes "loadScene（salt-flat 内联，其余 require.async）"
    dshPlugins.skin.scenes -> dshPlugins.skin.surface "piece + 调色板"
    dshPlugins.skin.surface -> dshPlugins.skin.mountRenderer "挂帧循环"
  }

  dynamic view settingsFlow {
    title "设置流"
    dshPlugins.skin.settingsPage -> dshPlugins.skin.store "store.update"
    dshPlugins.skin.store -> localStorage "写文档并广播"
    dshPlugins.skin.store -> dshPlugins.scenesLib.options "normalizeSettings 清洗"
    dshPlugins.skin.store -> dshPlugins.skin.app "值变化才通知，重挂画"
  }

  dynamic view jumpFlow {
    title "跳跃流：激活、快照、消费"
    user -> dshPlugins.jump.jumpApp "Cmd+H 点击 / Cmd+U 聚焦"
    dshPlugins.jump.jumpEntry -> dshPlugins.jump.jumpApp "apply(ctx, config)"
    dshPlugins.jump.jumpApp -> dshPlugins.jump.keys "matchKey 判定模式与前缀"
    dshPlugins.jump.jumpApp -> dshPlugins.jump.hints "collectHints 视口裁剪 + 等长 label"
    dshPlugins.jump.jumpApp -> dshPlugins.jump.overlay "render(hints, pending) 画徽标"
    dshPlugins.jump.jumpApp -> dshPlugins.jump.overlay "命中完整 label 后 destroy"
    dshPlugins.jump.jumpApp -> dshHost "激活期间 keydown 一律 preventDefault + stopPropagation"
  }

  dynamic view caretFlow {
    title "光标流：Home/End 在输入框内"
    user -> dshPlugins.keybindings.kbApp "在 composer 里按 Home"
    dshPlugins.keybindings.kbApp -> dshPlugins.keybindings.kbKeys "classifyTarget + matchCaretKey（行粒度）"
    dshPlugins.keybindings.kbApp -> dshPlugins.keybindings.kbCaret "preventDefault 后 Selection.modify(lineboundary)"
    dshPlugins.keybindings.kbApp -> dshPlugins.keybindings.kbReveal "把光标滚回 composer 自己的可视区"
    dshPlugins.keybindings.kbApp -> dshHost "聊天滚动容器不在补齐范围内，保持原 scrollTop"
  }

  dynamic view copyFlow {
    title "复制流：/copy 到剪贴板"
    user -> dshPlugins.slashCommands.tuiEntry "/copy [n] [--all]"
    dshPlugins.slashCommands.tuiEntry -> dshPlugins.slashCommands.command "registerCopyCommand（延后一宏任务）"
    dshPlugins.slashCommands.command -> dshPlugins.slashCommands.args "parseCopyInput"
    dshPlugins.slashCommands.command -> dshPlugins.slashCommands.history "collectTurns + renderTurns"
    dshPlugins.slashCommands.command -> dshPlugins.slashCommands.clipboard "copyToClipboard 并发三路"
    dshPlugins.slashCommands.clipboard -> systemClipboard "native：pbcopy / clip / wl-copy / xclip / xsel"
    dshPlugins.slashCommands.clipboard -> terminalHost "tmux load-buffer + OSC 52"
    dshPlugins.slashCommands.command -> dshHost "tuiToast 播报，降级改警告色"
  }

  dynamic view resumeFlow {
    title "切换流：/resume 到目标会话"
    user -> dshPlugins.slashCommands.clientEntry "/resume"
    dshPlugins.slashCommands.clientEntry -> dshPlugins.slashCommands.resumeCommand "commandUi.register 的贡献被弹层调用"
    dshPlugins.slashCommands.resumeCommand -> dshPlugins.slashCommands.resume "resumeRows 建行集（丢空白/归档/子代理，按 cwd 定项目档）"
    dshPlugins.slashCommands.resumeCommand -> dshHost "读 sessions.list 与 workspaces.list 快照"
    user -> dshPlugins.slashCommands.resumeCommand "选中顶部范围行：project 或 all"
    dshPlugins.slashCommands.resumeCommand -> dshHost "commandUi.popupFor(actx).open 重开弹层换档，搜索词先读后设回"
    user -> dshPlugins.slashCommands.resumeCommand "选中会话行"
    dshPlugins.slashCommands.resumeCommand -> dshHost "uiWorkspace.openSession(id) 导航过去，不续写、不加载上下文"
  }

  dynamic view clipboardFlow {
    title "剪贴板包装流：页面的 writeText 加上限"
    dshHost -> dshPlugins.slashCommands.clientEntry "激活客户端半边：apply 期内即刻安装，不等第一次复制"
    dshPlugins.slashCommands.clientEntry -> dshPlugins.slashCommands.clipboardShim "installBoundedClipboard 包住页面全局 writeText"
    user -> browserClipboard "点任意复制按钮：navigator.clipboard.writeText"
    browserClipboard -> dshPlugins.slashCommands.clipboardShim "先给平台调用 120 ms 预算"
    dshPlugins.slashCommands.clipboardShim -> browserClipboard "超时或失败则 execCommand('copy') 兜底，退出时还原 activeElement 的焦点"
    dshPlugins.slashCommands.clipboardShim -> dshPlugins.slashCommands.clientEntry "两路都失败才 reject，调用方的复制中标志总能释放"
  }

  deployment view deployment {
    title "部署：profile 安装态"
    include install.**
    autoLayout LeftRight
  }
}
{
  "name": "dsh-tui-copy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness TUI copy plugin: /copy [n] puts the last n assistant replies on the clipboard",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^3.2.0"
  }
}

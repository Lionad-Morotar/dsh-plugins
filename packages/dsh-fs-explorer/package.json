{
  "name": "dsh-fs-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness workbench file explorer: registers a conversation view over the workbench core service",
  "license": "MIT",
  "author": "Lionad <1806234223@qq.com>",
  "homepage": "https://github.com/Lionad-Morotar/dsh-plugins/tree/main/packages/dsh-fs-explorer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lionad-Morotar/dsh-plugins",
    "directory": "packages/dsh-fs-explorer"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["dsh-workbench-core"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "dsh-workbench-core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^3.2.0"
  }
}

{
  "name": "dsh-slash-commands",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness slash-command plugin: /copy on TUI, /rename and /resume on web and desktop",
  "license": "MIT",
  "author": "Lionad <1806234223@qq.com>",
  "homepage": "https://github.com/Lionad-Morotar/dsh-plugins/tree/main/packages/dsh-slash-commands#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lionad-Morotar/dsh-plugins",
    "directory": "packages/dsh-slash-commands"
  },
  "bugs": {
    "url": "https://github.com/Lionad-Morotar/dsh-plugins/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "slash-commands",
    "clipboard",
    "session"
  ],
  "icon": "./assets/icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh-plugin.json",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "vitest": "^3.2.0"
  }
}

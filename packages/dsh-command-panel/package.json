{
  "name": "dsh-command-panel",
  "version": "0.1.0",
  "description": "DeepSeek Harness command panel: Cmd+P file navigation, Cmd+Shift+P registered commands, Cmd+O workspace and session switching",
  "license": "MIT",
  "author": "Lionad <1806234223@qq.com>",
  "private": true,
  "homepage": "https://github.com/Lionad-Morotar/dsh-plugins/tree/main/packages/dsh-command-panel#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lionad-Morotar/dsh-plugins",
    "directory": "packages/dsh-command-panel"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "command-palette",
    "quick-open",
    "keyboard"
  ],
  "icon": "./assets/icon.svg",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "vitest": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "type": "module"
}
